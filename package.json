{
  "name": "ebed-debug-pro",
  "version": "0.3.0",
  "private": true,
  "description": "Embedded debug desktop workstation for serial, TCP/UDP, MQTT, Modbus, CAN, charts, logs, scripts and reports.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"wait-on tcp:5173 && node scripts/electron-dev.cjs\"",
    "dev:web": "vite --host 0.0.0.0 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "tsx --test tests/*.test.ts && node --test tests/*.test.cjs",
    "test:serial-ui": "npm run build && node scripts/test-serial-ui.cjs",
    "test:workspace-ui": "npm run build && node scripts/test-serial-ui.cjs --workspace",
    "pack:win": "npm run build && electron-builder --win dir --x64",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "smoke:desktop": "node scripts/smoke-desktop.cjs",
    "smoke:portable": "node scripts/smoke-desktop.cjs --portable"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mqtt": "^5.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "serialport": "^12.0.0"
  },
  "build": {
    "appId": "dev.ebed.studio",
    "productName": "EBED Studio",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "EBED-Studio-${version}-Windows-x64.exe",
      "requestExecutionLevel": "user"
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.15.3",
    "mqtt-packet": "^9.0.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
